# 智印助手后端环境变量示例：复制为 backend/.env 后按需修改
# 注意：本文件只放占位值，真实密钥只存在于服务端 .env，绝不进入前端代码

# ===== 应用 =====
DEBUG=true
AUTO_CREATE_TABLES=true
CORS_ORIGINS=*

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zhiyin
DB_USER=root
DB_PASSWORD=your_password
# 连接池：并发高时按机器与 MySQL 的 max_connections 调大；等连接超时就快失败
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=10

# ===== 对象存储 =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me_minio_access
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=zhiyin-files
MINIO_SECURE=false

# ===== AI 模型（后续可替换为学校提供的 Key 或校内私有化部署地址）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# AI 调用隔离：并发闸门与超时。模型接口慢，闸门是保护登录与下单的手段
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
LLM_MAX_CONCURRENCY=4
# AI 任务专用线程池：AI 慢活只占这几个名额，公共线程池留给交易链路
AI_MAX_WORKERS=4
AI_QUEUE_WAIT_SECONDS=30
LLM_QUEUE_WAIT_SECONDS=3

# ===== 管理员 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# ===== 业务配置 =====
# JWT_SECRET 至少 32 字节，生产环境务必替换为随机值
JWT_SECRET=please_change_me_to_a_random_string_of_32_bytes_or_more
JWT_EXPIRE_MINUTES=720
# 上传后允许多久之内下单；过期下单会被拦下并要求重新上传
ORDER_FILE_GRACE_HOURS=48
# 异常单引用的文件额外保留天数（异常单没有自动超时，不设上限会无限期占空间）
ABNORMAL_FILE_GRACE_DAYS=3
FILE_EXPIRE_HOURS=72
# 体检报告缓存保留天数（ai_reports 表），过期由后台定时任务清理
REPORT_RETENTION_DAYS=7
SIGNED_URL_EXPIRE_MINUTES=30

# ===== 定时清理 =====
# 过期上传文件与体检报告的后台清理任务。测试环境设为 false 可关闭
CLEANUP_ENABLED=true
# 两轮清理之间的间隔（分钟）
CLEANUP_INTERVAL_MINUTES=60

# LibreOffice headless 可执行文件路径（阶段 5-A 使用）。留空表示本机未安装，
# Office 文档一律报 50040，PDF 链路不受影响。
# Windows 例：C:\Program Files\LibreOffice\program\soffice.exe
# Linux 例：/usr/bin/soffice
# LibreOffice 转换：二选一
# 1) 本机装了 LibreOffice 就填可执行文件路径（Windows 形如 C:/Program Files/LibreOffice/program/soffice.exe）
SOFFICE_PATH=
# 2) 不装本机，用编排里的常驻转换容器（docker compose up -d libreoffice）
SOFFICE_CONTAINER=zhiyin-libreoffice
SOFFICE_TIMEOUT_SECONDS=180

# ===== 可扩展点配置（V1 用简化实现，V2 换实现只改这里）=====
AUTH_PROVIDER=device
PAYMENT_PROVIDER=mock
NOTIFIER_PROVIDER=poll
PRINTER_PROVIDER=manual

# 支付相关（V2 启用真实支付时填写，V1 留空即可）
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=
