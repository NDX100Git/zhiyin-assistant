# 智印助手后端环境变量示例：复制为 backend/.env 后按需修改
# 注意：本文件只放占位值，真实密钥只存在于服务端 .env，绝不进入前端代码

# ===== 应用 =====
DEBUG=true
AUTO_CREATE_TABLES=true
CORS_ORIGINS=*

# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zhiyin
DB_USER=root
DB_PASSWORD=your_password

# ===== 对象存储 =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=change_me_minio_access
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=zhiyin-files
MINIO_SECURE=false

# ===== AI 模型（后续可替换为学校提供的 Key 或校内私有化部署地址）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ===== 管理员 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# ===== 业务配置 =====
# JWT_SECRET 至少 32 字节，生产环境务必替换为随机值
JWT_SECRET=please_change_me_to_a_random_string_of_32_bytes_or_more
JWT_EXPIRE_MINUTES=720
FILE_EXPIRE_HOURS=24
SIGNED_URL_EXPIRE_MINUTES=30

# LibreOffice headless 路径（阶段 5-A 使用，按本机安装位置填写）
# 标准安装一般是 C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_TIMEOUT_SECONDS=180

# ===== 可扩展点配置（V1 用简化实现，V2 换实现只改这里）=====
AUTH_PROVIDER=device
PAYMENT_PROVIDER=mock
NOTIFIER_PROVIDER=poll
PRINTER_PROVIDER=manual

# 支付相关（V2 启用真实支付时填写，V1 留空即可）
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=
