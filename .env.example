# 智印助手环境变量模板
# 使用方法：复制本文件为 backend/.env，并按本机环境填写。
# 真实密钥只保存在 backend/.env（已 gitignore），不要提交、不要发给前端。

# ===== 应用 =====
DEBUG=true
AUTO_CREATE_TABLES=true
CORS_ORIGINS=*

# ===== 数据库（MySQL 8）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=zhiyin
DB_USER=root
DB_PASSWORD=change_me_db_password

# ===== 对象存储（MinIO）=====
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change_me_minio_access
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=zhiyin-files
MINIO_SECURE=false

# ===== AI 模型（DeepSeek，OpenAI 兼容）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# ===== 管理员（老师端登录）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# ===== 业务配置 =====
# JWT_SECRET 至少 32 字节随机字符串
JWT_SECRET=please_change_me_to_a_random_string_of_32_bytes_or_more
JWT_EXPIRE_MINUTES=720
FILE_EXPIRE_HOURS=24
SIGNED_URL_EXPIRE_MINUTES=30

# LibreOffice headless 路径（Windows 标准安装位置；也可指向解压目录）
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_TIMEOUT_SECONDS=180

# ===== 可扩展点（V1 简化实现，V2 换实现只改这里）=====
AUTH_PROVIDER=device
PAYMENT_PROVIDER=mock
NOTIFIER_PROVIDER=poll
PRINTER_PROVIDER=manual

# 支付相关（V2 启用真实支付时填写，V1 留空）
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=
