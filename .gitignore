# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
pytest-of-*/

# 环境变量与密钥：绝不提交
# 单个 .env 在任意层目录都不入库：.env、backend/.env、teacher-web/.env ……
.env
backend/.env
*.env
# 本机覆盖文件（Vite / uni-app 约定）：.env.local、.env.production.local ……
.env.local
.env.*.local
# 例外：只有占位值模板入库——.env.example 与前端 Vite 的公开配置
# （.env.development / .env.production 里只有后端地址，没有密钥）
!.env.example
!**/.env.example

# 运行时产物
backend/runtime/
backend/logs/
*.log

# 前端（后续阶段）
node_modules/
unpackage/
dist/

# 本地开发工具（MySQL 免安装版等）
.devtools/
.tools/
.data/
.runtime/

# MinIO 本地数据目录：含大量二进制对象，绝不入库
.minio-data/
