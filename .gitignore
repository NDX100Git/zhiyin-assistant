# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
pytest-of-*/

# 环境变量与密钥：绝不提交
# 单个 .env 在任意层目录都不入库：.env、backend/.env、teacher-web/.env ……
.env
backend/.env
*.env
# 所有按环境拆分的 env 文件都不入库：.env.production、.env.staging、.env.local ……
.env.*
# 例外：只有占位值模板与前端公开配置入库
# 前端 .env.development / .env.production 里只有后端地址与轮询间隔，没有密钥
!.env.example
!**/.env.example
!student-app/.env.development
!student-app/.env.production
!teacher-web/.env.development
!teacher-web/.env.production

# 运行时产物
backend/runtime/
backend/logs/
*.log

# 前端（后续阶段）
node_modules/
unpackage/
dist/

# 本地开发工具（MySQL 免安装版等）
.devtools/
.tools/
.data/
.runtime/

# MinIO 本地数据目录：含大量二进制对象，绝不入库
.minio-data/
